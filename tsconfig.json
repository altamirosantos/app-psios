{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "moduleResolution": "nodenext",
  "types": ["react", "react-native"],
  "typeRoots": ["./node_modules/@types"],
  "allowSyntheticDefaultImports": true,
  "esModuleInterop": true,
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
